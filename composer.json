{
    "name": "carmelosantana/coqui-browser",
    "description": "Playwright PHP browser toolkit for Coqui — robust browser sessions, multi-tab workflows, snapshots, captures, and storage state management.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "coqui",
        "php-agents",
        "browser",
        "playwright",
        "automation",
        "toolkit"
    ],
    "authors": [
        {
            "name": "Carmelo Santana"
        }
    ],
    "require": {
        "php": "^8.4",
        "carmelosantana/php-agents": "^0.16",
        "playwright-php/playwright": "^1.5",
        "symfony/process": "^7.3 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "CoquiBrowser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoquiBrowser\\Tests\\": "tests/"
        }
    },
    "extra": {
        "php-agents": {
            "toolkits": [
                "CoquiBrowser\\BrowserToolkit"
            ],
            "description": "Browser automation via Playwright PHP for Coqui.",
            "gated": {
                "browser_session": [
                    "setup",
                    "close_all"
                ],
                "browser_interact": [
                    "evaluate"
                ]
            }
        }
    },
    "scripts": {
        "test": "pest --testsuite=Unit",
        "test:integration": "pest --testsuite=Integration",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
